rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // ВРЕМЕННО: открытый доступ до 2026-12-22 (как test mode).
    // Перед публичным запуском заменить на Auth + правила «только владелец».
    match /{document=**} {
      allow read, write: if request.time < timestamp.date(2026, 12, 22);
    }
  }
}
